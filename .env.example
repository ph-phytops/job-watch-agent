# Copy this file to ".env" and fill in real values.
# ".env" is listed in .gitignore and must NEVER be committed.

# Dedicated mailbox that receives the job alerts (Gmail).
JOBWATCH_EMAIL_USER=your-alerts-address@gmail.com

# Google "App password" (16 characters, requires 2-Step Verification).
# Google Account -> Security -> 2-Step Verification -> App passwords.
JOBWATCH_EMAIL_PASSWORD=xxxxxxxxxxxxxxxx

# Where to send the digest when new positions are found
# (your personal address; defaults to JOBWATCH_EMAIL_USER if omitted).
JOBWATCH_NOTIFY_TO=your-personal-address@example.com

# Optional — only if the LLM CLI used by "uv run jobwatch.py --llm" is not on
# your PATH. Absolute path, forward slashes. Leave unset when "claude" resolves.
# JOBWATCH_LLM_COMMAND=C:/path/to/claude.exe
